{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layer Mixer",
  "version": "0.46.0",
  "identifier": "io.github.duempelhuber.layermixer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Duempelhuber",
    "copyright": "Copyright (c) 2026 Duempelhuber. All rights reserved.",
    "shortDescription": "Plan layered paint schemes for miniatures",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi"
      }
    }
  }
}
